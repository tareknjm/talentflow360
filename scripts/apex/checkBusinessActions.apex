TF_GetCandidateBrief.Request briefRequest=new TF_GetCandidateBrief.Request();
briefRequest.candidateCode='TF-DEMO-006';
TF_ActionResult brief=TF_GetCandidateBrief.run(new List<TF_GetCandidateBrief.Request>{briefRequest})[0];
System.assertEquals('SUCCESS',brief.resultCode);
Map<String,Object> allowed=(Map<String,Object>)JSON.deserializeUntyped(brief.payloadJson);
System.assertEquals(new Set<String>{'candidateCode','role','javaEvidence','springEvidence','availability','missingInformation'},allowed.keySet());
System.assertEquals(3,((List<Object>)allowed.get('missingInformation')).size());
TF_ListInterviewSlots.Request listRequest=new TF_ListInterviewSlots.Request();
listRequest.candidateCode='TF-DEMO-001';listRequest.periodStart=System.now();listRequest.periodEnd=System.now().addDays(30);
TF_ActionResult listing=TF_ListInterviewSlots.run(new List<TF_ListInterviewSlots.Request>{listRequest})[0];
System.assertEquals('SUCCESS',listing.resultCode);
Map<String,Object> listed=(Map<String,Object>)JSON.deserializeUntyped(listing.payloadJson);
List<Object> slots=(List<Object>)listed.get('slots');
System.assert(!slots.isEmpty(),'Un créneau futur synthétique est nécessaire.');
TF_ReserveInterview.Request reserveRequest=new TF_ReserveInterview.Request();
reserveRequest.candidateCode='TF-DEMO-001';reserveRequest.slotId=(Id)(String)((Map<String,Object>)slots[0]).get('slotId');
reserveRequest.requestKey='SMOKE-NO-CONFIRM';reserveRequest.confirmed=false;
System.assertEquals('INVALID_INPUT',TF_ReserveInterview.run(new List<TF_ReserveInterview.Request>{reserveRequest})[0].resultCode);
TF_GetOnboardingStatus.Request statusRequest=new TF_GetOnboardingStatus.Request();statusRequest.candidateCode='TF-DEMO-001';
System.assertEquals('SUCCESS',TF_GetOnboardingStatus.run(new List<TF_GetOnboardingStatus.Request>{statusRequest})[0].resultCode);
System.assertEquals(0,Limits.getEmailInvocations());
System.debug(LoggingLevel.INFO,'TF_ACTION_SMOKE=SUCCESS; REAL_APEX_ACTIONS; NO_AGENTFORCE_PROOF');
