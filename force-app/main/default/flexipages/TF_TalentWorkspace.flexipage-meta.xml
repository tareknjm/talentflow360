        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;Prochaine action : Compléter le dossier&lt;/h2&gt;&lt;p&gt;Renseignez le rôle, les preuves disponibles et la disponibilité. Une information inconnue reste à vérifier.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>nextActionDraft</identifier>
                <visibilityRule>
                    <criteria>
                        <leftValue>{!Record.Status__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>Draft</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;Prochaine action : Préparer l’entretien&lt;/h2&gt;&lt;p&gt;Consultez les preuves dans Préparation. Ouvrez TalentFlow Assistant avec le code candidat pour préparer les questions et rechercher un créneau.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>nextActionReadyForReview</identifier>
                <visibilityRule>
                    <criteria>
                        <leftValue>{!Record.Status__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>ReadyForReview</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;Prochaine action : Choisir un créneau&lt;/h2&gt;&lt;p&gt;Consultez les créneaux réels avec TalentFlow Assistant. Confirmez le code candidat et l’horaire avant toute réservation.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>nextActionInterviewRequested</identifier>
                <visibilityRule>
                    <criteria>
                        <leftValue>{!Record.Status__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>InterviewRequested</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;Prochaine action : Consulter la réservation&lt;/h2&gt;&lt;p&gt;L’entretien est planifié. Ouvrez Entretiens pour vérifier la réservation. La décision RH appartient au parcours humain autorisé.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>nextActionInterviewScheduled</identifier>
                <visibilityRule>
                    <criteria>
                        <leftValue>{!Record.Status__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>InterviewScheduled</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;Prochaine action : Suivre l’intégration&lt;/h2&gt;&lt;p&gt;L’embauche est validée. Ouvrez Intégration pour consulter les étapes et leurs échéances. Les tâches générées restent à accomplir par les personnes concernées.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>nextActionHired</identifier>
                <visibilityRule>
                    <criteria>
                        <leftValue>{!Record.Status__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>Hired</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;Préparer la prochaine action&lt;/h2&gt;&lt;p&gt;Ouvrez le panneau &lt;strong&gt;TalentFlow Assistant&lt;/strong&gt; avec le code candidat de ce dossier.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Lire le brief et préparer trois questions.&lt;/li&gt;&lt;li&gt;Consulter les créneaux et réserver après confirmation.&lt;/li&gt;&lt;li&gt;Lire les étapes du parcours.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Les preuves restent déclarées ou enregistrées selon leur provenance. L’assistant ne classe pas les candidats et ne décide pas de l’embauche.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>assistantGuide</identifier>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h2&gt;Une décision humaine séparée&lt;/h2&gt;&lt;p&gt;Les RH autorisés utilisent &lt;strong&gt;Valider l’embauche&lt;/strong&gt;, puis le formulaire dédié. La satisfaction est saisie après validation.&lt;/p&gt;&lt;p&gt;Fermez ces formulaires avant de reprendre la conversation. Aucune identité, satisfaction ou validation RH ne doit être transmise au chat.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>humanDecisionGuide</identifier>
            </componentInstance>
        </itemInstances>
