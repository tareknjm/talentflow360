<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>HiringRequiresApproval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Hired"), OR(NOT(HumanApproved__c), ISBLANK(ApprovedBy__c), ISBLANK(ApprovedAt__c), ISBLANK(StartDate__c)))</errorConditionFormula>
    <errorMessage>L’embauche exige la validation RH et une date d’arrivée.</errorMessage>
</ValidationRule>
