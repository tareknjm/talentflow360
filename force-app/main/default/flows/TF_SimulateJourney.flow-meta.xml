<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Simulate_Step</name>
        <label>Simulate_Step</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <actionName>TF_SimulateJourney</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Check_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Failure_Screen</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>stepId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>resultCode</assignToReference>
            <name>resultCode</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <decisions>
        <name>Check_Authorization</name>
        <label>Vérifier l’autorisation</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Denied_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non autorisé</defaultConnectorLabel>
        <rules>
            <name>Authorized</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.TF_DemoTools</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Input_Screen</targetReference>
            </connector>
            <label>Autorisé</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Result</name>
        <label>Vérifier la simulation</label>
        <locationX>50</locationX>
        <locationY>250</locationY>
        <defaultConnector>
            <targetReference>Failure_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non exécutée</defaultConnectorLabel>
        <rules>
            <name>Success</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>resultCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SUCCESS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>resultCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ALREADY_COMPLETED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Result_Screen</targetReference>
            </connector>
            <label>Exécutée ou déjà traitée</label>
        </rules>
    </decisions>
    <description>Parcours interne distinct, jamais exposé à Agentforce.</description>
    <interviewLabel>TF — Simulation J+30 / J+60 / J+90 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TF — Simulation J+30 / J+60 / J+90</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
